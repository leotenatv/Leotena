DATABASE_URL=postgresql://user:pass@host:5432/db
JWT_SECRET=change-me-64-hex-chars
ADMIN_EMAIL=admin@leotena.com
ADMIN_PASSWORD=admin123
PORT=4000

# ADMIN_* are read by `npm run seed` and `npm run reset-admin` only —
# changing them on Railway does not update login until you run reset-admin.

# Firebase Admin SDK (push notifications) — from the Firebase service account
# JSON: project_id, client_email, private_key. FIREBASE_PRIVATE_KEY keeps its
# "\n" escapes literally in the env var; the server un-escapes them at runtime.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvA...\n-----END PRIVATE KEY-----\n"
# Aliases accepted by firebase.js:
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=

# Shared secret for SupaAdmin (Supasoka) push mirror. Either name is accepted.
# Must match LEOTENA_BRIDGE_SECRET on the Supasoka backend. Header: X-Partner-Secret.
# SUPA_LEOTENA_BRIDGE_SECRET=
# LEOTENA_BRIDGE_SECRET=
# LEOTENA_API_BASE_URL=https://leotena-production-d6b5.up.railway.app

# SonicPesa (same account as Washa) — server-side only; never ship in the Flutter app.
# Copy the exact values from the Washa Railway service env.
# SONICPESA_API_KEY=
# SONICPESA_SECRET_KEY=
# SONICPESA_BASE_URL=https://api.sonicpesa.com
# Optional webhook auth (set the same secret in SonicPesa if they support custom headers)
# SONICPESA_WEBHOOK_SECRET=
#
# Local / zero-amount payments (dev only). When true, Lipia sasa skips Sonic USSD.
# Leave unset/false in production so users must enter PIN before unlock.
# ALLOW_LOCAL_PAYMENTS=false
#
# Paste in SonicPesa → Webhook System → HTTPS ENDPOINT URL (after deploy):
# https://leotena-production-d6b5.up.railway.app/webhooks/sonicpesa
